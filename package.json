{
  "name": "fdstoolkit-release-tooling",
  "version": "0.0.0-managed-by-semantic-release",
  "private": true,
  "description": "Release tooling only. The package itself is Python and is installed from a release tarball or through Homebrew.",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write \"**/*.{json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{json,yml,yaml}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@vitest/coverage-v8": "5.0.1",
    "happy-dom": "^20.14.5",
    "prettier": "3.9.6",
    "semantic-release": "25.0.9",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.5.1"
}
