# Folder that receives one session-<time>.jsonl recording per opening of the FDSStick. Unset records nothing.
FDSTOOLKIT_RECORD=

# SQLite file that holds the logbook of dumps, grades and calibrations.
# Unset uses $XDG_DATA_HOME/fdstoolkit/logbook.sqlite3, or $HOME/.local/share/fdstoolkit/logbook.sqlite3.
FDSTOOLKIT_LOGBOOK=

# Label of the drive attached to the FDSStick, so the logbook keeps each drive's history apart. Unset is "drive".
FDSTOOLKIT_DRIVE=

# Disk Writer serial that write --as-kiosk stamps, four hexadecimal digits from 0001 to FFFE. Unset refuses a kiosk rewrite.
FDSTOOLKIT_KIOSK_SERIAL=
